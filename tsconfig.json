{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"outDir": "dist",
		"sourceMap": true,
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"verbatimModuleSyntax": true,
		"allowJs": true,
		"rootDir": "./",
		"strictNullChecks": true,
		"removeComments": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noEmitOnError": true
	},
	"include": [
		"**/*.ts",
		"**/*.js",
		"**/*.mjs"
	],
	"exclude": [
		"node_modules",
		".vscode",
		"dist",
		"examples",
		"test",
		"vitest.config.js"
	]
}
