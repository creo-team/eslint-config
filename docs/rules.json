      "options": [
        4,
        {
          "SwitchCase": 1,
          "VariableDeclarator": 1,
          "outerIIFEBody": 1,
          "assignmentOperator": 1,
          "FunctionDeclaration": {
            "parameters": 1,
            "body": 1,
            "returnType": 1
          },
          "FunctionExpression": {
            "parameters": 1,
            "body": 1,
            "returnType": 1
          },
          "StaticBlock": {
            "body": 1
          },
          "CallExpression": {
